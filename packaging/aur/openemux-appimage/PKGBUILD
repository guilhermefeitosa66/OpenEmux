# Maintainer: Guilherme Feitoza <guilhermefeitosa66@gmail.com>
#
# The AUR's openemux-appimage: the release AppImage, installed under
# /opt/openemux-appimage with a /usr/bin/openemux link, the desktop entry, the
# icon and the metainfo, for those who want the self-contained build that
# carries its own GTK stack and RetroArch (issue #991).
#
# Everything but the AppImage itself is read out of the AppImage, so the
# recipe downloads the one release asset and nothing else.
#
# This file is a template. `pkgver`, `pkgrel` and `sha256sums` are written by
# packaging/aur/release.py for a given release tag; the checksum is the one in
# the release's SHA256SUMS.

pkgname=openemux-appimage
_pkgname=openemux
_appid=io.github.guilhermefeitosa66.OpenEmux
pkgver=0.0.0
pkgrel=1
pkgdesc="Linux-native emulator frontend for RetroArch, inspired by OpenEmu (AppImage)"
arch=('x86_64')
url="https://openemux.libre-apps.org/"
license=('MIT')
# The AppImage runtime mounts the image through FUSE 2; the icon goes into
# the hicolor theme, which owns that hierarchy.
depends=('fuse2' 'hicolor-icon-theme')
provides=("$_pkgname")
conflicts=("$_pkgname")

_appimage="OpenEmux-$pkgver-x86_64.AppImage"
source=("$_appimage::https://github.com/guilhermefeitosa66/OpenEmux/releases/download/v$pkgver/$_appimage")
noextract=("$_appimage")
sha256sums=('SKIP')

# An AppImage is a signed-off image: stripping or rewriting it breaks it.
options=('!strip' '!debug')

prepare() {
  cd "$srcdir"
  chmod +x "$_appimage"
  rm -rf squashfs-root
  # Only the files the desktop needs, and the licence texts. Extracting needs
  # no FUSE: the runtime reads its own squashfs.
  for path in "usr/share/applications/$_appid.desktop" \
              "usr/share/icons/hicolor/512x512/apps/$_appid.png" \
              "usr/share/metainfo/$_appid.metainfo.xml" \
              'usr/lib/openemux/LICENSE' 'usr/lib/openemux/copyright'; do
    ./"$_appimage" --appimage-extract "$path" >/dev/null
    test -f "squashfs-root/$path"
  done
}

package() {
  install -Dm755 "$srcdir/$_appimage" "$pkgdir/opt/$pkgname/OpenEmux.AppImage"
  install -d "$pkgdir/usr/bin"
  ln -s "/opt/$pkgname/OpenEmux.AppImage" "$pkgdir/usr/bin/$_pkgname"

  cd "$srcdir/squashfs-root"
  install -Dm644 "usr/share/applications/$_appid.desktop" \
    "$pkgdir/usr/share/applications/$_appid.desktop"
  # The same Exec line the native packages write (stage_tree.sh).
  sed -i 's|^Exec=.*|Exec=/usr/bin/openemux|' \
    "$pkgdir/usr/share/applications/$_appid.desktop"
  grep -q '^TryExec=' "$pkgdir/usr/share/applications/$_appid.desktop" ||
    sed -i '/^Exec=/a TryExec=/usr/bin/openemux' \
      "$pkgdir/usr/share/applications/$_appid.desktop"
  install -Dm644 "usr/share/icons/hicolor/512x512/apps/$_appid.png" \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/$_appid.png"
  install -Dm644 "usr/share/metainfo/$_appid.metainfo.xml" \
    "$pkgdir/usr/share/metainfo/$_appid.metainfo.xml"
  install -Dm644 usr/lib/openemux/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 usr/lib/openemux/copyright "$pkgdir/usr/share/licenses/$pkgname/copyright"
}

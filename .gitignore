*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Coverage reports (make coverage)
.coverage
htmlcov/

# Virtual Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# IDEs
.idea/
.vscode/

# Project specific
app_data/
*.log
AppDir/
appimage-builder-cache/
appimage-build/

# Vendor build artifacts (compiled binaries — use 'make build-emulators' to rebuild)
vendors/nestopia/nestopia
vendors/nestopia/build/
vendors/mgba/build/
vendors/snes9x/gtk/build/

# Fetched vendors (issue #118). The Windows RetroArch is ~193 MiB, so unlike the
# 10.9 MiB Linux AppImage it is downloaded on demand rather than committed --
# see vendors/manifest.json and 'make vendor-retroarch'.
vendors/RetroArch-Win64/
vendors/.cache/
vendors/*.7z

# Windows bundle staging (packaging/windows)
build/win/
# Derived from src/openemux/ui/assets/images/logo.png during the build, and
# removed again; only ever present if a build was interrupted mid-way.
packaging/windows/openemux.ico

# Parallel development worktrees
.worktree/

# Local-only release drafts (announcement posts, PT release notes)
release/*post*.txt
release/NOTAS_DE_RELEASE_*.md

# Flatpak build outputs
flatpak-repo/
.flatpak-build-dir/
.flatpak-builder/
